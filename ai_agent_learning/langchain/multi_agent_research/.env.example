# Copy this file to `.env` in the project root and fill in your keys.
#   cp .env.example .env
#
# `.env` is git-ignored. This file is committed on purpose: it documents
# which keys are needed without ever exposing their values.

# Groq — chat model inference. https://console.groq.com/keys
GROQ_API_KEY=

# Tavily — web search. https://app.tavily.com
TAVILY_API_KEY=
